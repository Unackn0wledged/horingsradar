# Høringsradar – kopier til .env og fyll inn. .env skal aldri committes.
# På lab: /opt/horingsradar/.env, eid av tjenestebrukeren, chmod 600.

# --- Lagring --------------------------------------------------------------
# All tilstand (SQLite, cache, dokumenter, tekst, LLM-svar, rapporter, logger).
# Lokalt: ./data. På lab MÅ dette være /var/lib/horingsradar, ellers får ikke
# systemd-tjenestene (ProtectSystem=strict) skrive.
DATA_DIR=./data

# --- regjeringen.no -------------------------------------------------------
# Identifiserende User-Agent med kontaktinfo.
USER_AGENT=Horingsradar/0.1 (kontakt: navn@example.no)
# Minst 2 sekunder mellom kall (lavere verdier avvises).
REQUEST_INTERVAL_SECONDS=2
# Hvor lenge HTML-sider gjenbrukes fra disk-cache (sekunder).
HTML_CACHE_MAX_AGE_SECONDS=3600
# Første run henter høringer publisert de siste N dagene.
INITIAL_LOOKBACK_DAYS=90
# Senere runs går tilbake til forrige kjøring minus N dager.
DISCOVERY_OVERLAP_DAYS=14

# --- LLM ------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=16000
# Ved avvisning (refusal) prøver API-et automatisk en annen modell. Modellen som svarte lagres.
LLM_REFUSAL_FALLBACK=true
ANTHROPIC_API_KEY=
PROMPT_VERSION=v1
# Input over dette deles per kapittel.
MAX_INPUT_TOKENS=150000
# Brukes til estimater før det finnes faktiske tall i databasen.
CHARS_PER_TOKEN=3.0

# --- Kostnad (USD per million tokens, brukes til estimater) ----------------
PRICE_INPUT_PER_MTOK=2.0
PRICE_OUTPUT_PER_MTOK=10.0
# Batch-API (backtest) faktureres til halv pris.
BATCH_PRICE_FACTOR=0.5
BACKTEST_POLL_SECONDS=60

# --- Adminpanel -----------------------------------------------------------
# Kommaseparert liste med adresse:port. På lab: containerens LAN-adresse, for eksempel
# WEB_BIND=192.168.1.50:8080. Kjører Tailscale inne i containeren, legges også
# Tailscale-adressen til: WEB_BIND=192.168.1.50:8080,100.101.102.103:8080
WEB_BIND=127.0.0.1:8080
WEB_USERNAME=operator
# Lag med: uv run horingsradar hash-password
WEB_PASSWORD_HASH=
# Brukes bare til å vise neste planlagte kjøring i panelet.
RUN_TIMER_UNIT=horingsradar-run.timer

LOG_LEVEL=INFO
