# EU/EØS-radar – kopier til .env i EU-instansens mappe og fyll inn. .env skal aldri committes.
# På lab: /opt/horingsradar-eu/.env, eid av tjenestebrukeren, chmod 600.
# Se docs/INSTALL-EU.md. Høringsradar (regjeringen.no) bruker .env.example.

# --- Instans --------------------------------------------------------------
# Påkrevd. horingsradar-eu nekter å starte uten, så den aldri bruker feil database.
RADAR=eu

# --- Lagring --------------------------------------------------------------
# Egen mappe, aldri den samme som Høringsradar bruker.
# Lokalt: ./data-eu. På lab MÅ dette være /var/lib/horingsradar-eu.
DATA_DIR=./data-eu

# --- Kilder ---------------------------------------------------------------
# Identifiserende User-Agent med kontaktinfo.
USER_AGENT=Horingsradar-EU/0.1 (kontakt: navn@example.no)
# Minst 2 sekunder mellom kall (lavere verdier avvises).
REQUEST_INTERVAL_SECONDS=2
# Første kjøring henter forslag fra de siste N dagene (730 = 24 måneder).
EU_INITIAL_LOOKBACK_DAYS=730
# Senere kjøringer går tilbake til forrige kjøring minus N dager (EuroVoc kommer sent).
EU_DISCOVERY_OVERLAP_DAYS=60
# Egen nøkkelordliste, ett per linje. Tom = den innebygde listen i eu/prefilter.py.
EU_KEYWORDS_FILE=

# --- LLM ------------------------------------------------------------------
LLM_PROVIDER=anthropic
# En liten, billig modell holder: bare tittel og sammendrag vurderes.
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4000
LLM_REFUSAL_FALLBACK=true
# Bruk gjerne en egen nøkkel (eget workspace), så forbruket ikke blandes med Høringsradar.
ANTHROPIC_API_KEY=
EU_PROMPT_VERSION=v1

# --- Kostnad (USD per million tokens, brukes til estimater) ----------------
# Sett prisene for modellen over og fjern #. Uten dem brukes standardverdiene, som passer en
# større modell, og kostnadsestimatene blir for høye.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
BATCH_PRICE_FACTOR=0.5

# --- Adminpanel (kommer i milepæl 8) ----------------------------------------
# Egen port, ikke den samme som Høringsradar.
WEB_BIND=127.0.0.1:8081
WEB_USERNAME=operator
WEB_PASSWORD_HASH=
RUN_TIMER_UNIT=horingsradar-eu-run.timer

LOG_LEVEL=INFO
