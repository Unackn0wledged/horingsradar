<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<title>Høringsradar – {{ period_label }}</title>
{% include "_style.html.j2" %}
</head>
<body>
{% import "_macros.html.j2" as m with context %}

<div class="masthead">
  <h1>Høringsradar</h1>
  <div class="sub">Høringer fra regjeringen.no sortert etter personvernrelevans</div>
</div>
<div class="meta">
  <span><strong>Periode:</strong> {{ period_label }}</span>
  <span><strong>Generert:</strong> {{ generated_at }}</span>
  <span><strong>Høringer:</strong> {{ views|length }}</span><br>
  <span><strong>Modell og prompt:</strong> {{ models|join(", ") if models else "–" }}</span>
</div>
<div class="notice">
  <strong>Merk:</strong> Relevansnivå, sammendrag, funn og leseguide er KI-generert sortering og må verifiseres mot kildedokumentene.
  Verktøyet tar ikke stilling til forslagene og skriver ikke høringsinnspill. Tittel, datoer, frist, departement og adresseliste er hentet direkte fra regjeringen.no.
  Sitater er kontrollert maskinelt mot dokumentteksten; sitater som ikke kunne bekreftes er tydelig merket.
</div>

<h2 id="oversikt">Oversikt</h2>
{% if views %}
<p class="counts">{% for c in relevance_counts %}<span class="badge rel-{{ c.level }}">{{ c.count }} {{ c.label }}</span> {% endfor %}</p>
<p class="legend">DT = Datatilsynet. Sortert etter relevans og deretter frist. Klikk på en tittel for å gå til høringen lenger ned i rapporten.</p>
<table class="overview">
  <thead>
    <tr>
      <th class="rel">Relevans</th><th>Høring</th><th class="date">Frist</th><th class="days">Dager igjen</th><th class="dt">DT på adresse&shy;listen</th>
    </tr>
  </thead>
  <tbody>
  {% for v in views %}
    <tr>
      <td><a class="badge-link" href="#h{{ v.id }}"><span class="badge rel-{{ v.relevance }}">{{ v.relevance_label }}</span></a></td>
      <td>
        <div class="row-title"><a href="#h{{ v.id }}">{{ v.row.title }}</a>{% if v.changes %}{% for t in v.changes.tags %}<span class="tag">{{ t }}</span>{% endfor %}{% endif %}</div>
        <div class="row-meta">{{ v.row.department or "–" }} · publisert {{ v.row.published_date|date }}{% if v.sectors %} · {{ v.sectors|join(", ") }}{% endif %}</div>
      </td>
      <td class="date">{{ v.row.deadline|date }}</td>
      <td class="num">{% if v.days_left is none %}–{% elif v.days_left < 0 %}utløpt{% else %}{{ v.days_left }}{% endif %}</td>
      <td>{% if v.row.dt_on_address_list is none %}–{% elif v.row.dt_on_address_list %}Ja{% else %}Nei{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">{% if kind == "drift" %}Ingen nye eller oppdaterte høringer siden forrige rapport.{% else %}Ingen høringer publisert i perioden.{% endif %}</p>
{% endif %}

{% if kind == "drift" %}
<h2>Frister som nærmer seg</h2>
<p class="muted">Åpne høringer med høy eller middels relevans fra tidligere rapporter, med frist innen 28 dager.</p>
{% if upcoming %}
<table>
  <thead><tr><th>Relevans</th><th>Tittel</th><th>Departement</th><th>Frist</th><th>Dager igjen</th></tr></thead>
  <tbody>
  {% for v in upcoming %}
    <tr>
      <td><span class="badge rel-{{ v.relevance }}">{{ v.relevance_label }}</span></td>
      <td><a href="{{ v.row.url }}">{{ v.row.title }}</a></td>
      <td>{{ v.row.department or "–" }}</td>
      <td class="date">{{ v.row.deadline|date }}</td>
      <td class="num">{{ v.days_left }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">Ingen.</p>
{% endif %}
{% endif %}

{% if kind == "drift" and deadline_only %}
<h2>Endringer i tidligere rapporterte høringer</h2>
<p class="muted">Høringer med høy eller middels relevans fra tidligere rapporter der bare fristen er endret. Vurderingen er den samme som sist.</p>
<ul class="brief">
{% for v in deadline_only %}
  <li><span class="badge rel-{{ v.relevance }}">{{ v.relevance_label }}</span> <a href="{{ v.row.url }}">{{ v.row.title }}</a><br>
    Frist endret fra {{ v.changes.deadline[0]|date }} til <strong>{{ v.changes.deadline[1]|date }}</strong>{% if v.days_left is not none and v.days_left >= 0 %} ({{ v.days_left }} dager igjen){% endif %}.</li>
{% endfor %}
</ul>
{% endif %}

<h2>Høy og middels relevans</h2>
{% if not detailed %}<p class="empty">Ingen høringer med høy eller middels relevans i perioden.</p>{% endif %}
{% for v in detailed %}
<section class="hearing" id="h{{ v.id }}">
  <h3><span class="badge rel-{{ v.relevance }}">{{ v.relevance_label }}</span> <a href="{{ v.row.url }}">{{ v.row.title }}</a>{% if v.changes %}{% for t in v.changes.tags %}<span class="tag">{{ t }}</span>{% endfor %}{% endif %}</h3>
{{ m.facts(v) }}

  {% if v.changes %}
  {% set c = v.changes %}
  <div class="changes">
    <div class="changes-head">Endret siden rapporten {{ c.since|date }}</div>
    <table>
      {% if c.deadline %}<tr><td class="what">Frist</td><td>{{ c.deadline[0]|date }} → <strong>{{ c.deadline[1]|date }}</strong></td></tr>{% endif %}
      {% if c.relevance %}<tr><td class="what">Relevans</td><td>{{ relevance_labels.get(c.relevance[0], c.relevance[0]) }} → <strong>{{ relevance_labels.get(c.relevance[1], c.relevance[1]) }}</strong></td></tr>{% endif %}
      {% for d in c.documents %}<tr><td class="what">{{ d.label }}</td><td>«{{ d.title }}», {{ d.date|date }}</td></tr>{% endfor %}
      {% if c.new_findings or c.dropped_findings %}<tr><td class="what">Funn</td><td>{% if c.new_findings %}{{ c.new_findings }} {{ "nytt" if c.new_findings == 1 else "nye" }} (merket «Ny» under){% endif %}{% if c.new_findings and c.dropped_findings %}, {% endif %}{% if c.dropped_findings %}{{ c.dropped_findings }} fra forrige rapport er ikke med lenger{% endif %}</td></tr>{% endif %}
    </table>
  </div>
  {% endif %}
{{ m.analysis(v, show_new=v.changes) }}
  <p class="back"><a href="#oversikt">↑ Til oversikten</a></p>
</section>
{% endfor %}

<h2>Lav og ingen relevans</h2>
{% if brief %}
<ul class="brief">
{% for v in brief %}
  <li id="h{{ v.id }}"><span class="badge rel-{{ v.relevance }}">{{ v.relevance_label }}</span> <a href="{{ v.row.url }}">{{ v.row.title }}</a>
    <span class="muted"> · {{ v.row.department or "–" }} · frist {{ v.row.deadline|date }}</span><br>
    {{ v.assessment.relevance_reason }} <a class="back-inline" href="#oversikt">↑ Til oversikten</a></li>
{% endfor %}
</ul>
{% else %}
<p class="empty">Ingen.</p>
{% endif %}

{% if not_assessed %}
<h2>Ikke vurdert</h2>
<p class="muted">Høringer som er hentet, men ikke har en gyldig vurdering ennå. De er ikke filtrert bort og vurderes på nytt ved neste kjøring.</p>
<ul class="brief">
{% for v in not_assessed %}
  <li id="h{{ v.id }}"><span class="badge rel-{{ v.relevance }}">{{ v.relevance_label }}</span> <a href="{{ v.row.url }}">{{ v.row.title }}</a>
    <span class="muted"> · {{ v.row.department or "–" }} · frist {{ v.row.deadline|date }}</span><br>
    {% if v.assessment %}Vurderingen feilet: {{ v.assessment.error }}{% else %}Venter på vurdering.{% endif %} <a class="back-inline" href="#oversikt">↑ Til oversikten</a></li>
{% endfor %}
</ul>
{% endif %}

</body>
</html>
