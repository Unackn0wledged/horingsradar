{# Macros shared by report.html.j2 and hearing.html.j2. Import with context (status_labels). #}
{% macro page_ranges(items) %}{% for r in items %}{% if not loop.first %}{{ " og " if loop.last else ", " }}{% endif %}{% if r.href %}<a class="page" href="{{ r.href }}">{{ r.label }}</a>{% else %}{{ r.label }}{% endif %}{% endfor %}{% endmacro %}

{# show_days_left: off in the single-hearing PDF, which the website caches for days. #}
{% macro facts(v, show_days_left=true) %}
  <dl class="facts">
    <div><dt>Departement</dt><dd>{{ v.row.department or "–" }}{% if v.row.original_department %} (opprinnelig utgitt av {{ v.row.original_department }}){% endif %}</dd></div>
    <div><dt>Publisert / frist</dt><dd>{{ v.row.published_date|date }} / {{ v.row.deadline|date }}{% if show_days_left and v.days_left is not none and v.days_left >= 0 %} ({{ v.days_left }} dager igjen){% endif %}</dd></div>
    <div><dt>Status</dt><dd>{{ v.row.status_raw or status_labels.get(v.row.status, "–") }}</dd></div>
    <div><dt>Datatilsynet på adresselisten</dt><dd>{% if v.row.dt_on_address_list %}Ja{% elif v.row.dt_on_address_list is none %}–{% else %}Nei{% endif %}</dd></div>
    <div><dt>Sektor</dt><dd>{{ v.sectors|join(", ") if v.sectors else "–" }}</dd></div>
    {% set ps = v.privacy_section %}
    <div><dt>Eget personvernkapittel</dt><dd>{% if ps is none %}–{% elif not ps.exists %}Nei{% else %}Ja{% if ps.chapter %} «{{ ps.chapter }}»{% endif %}{% if ps.pages %}, s. {{ page_ranges(ps.pages) }}{% endif %}{% if ps.document_title %} i {{ ps.document_title }}{% endif %}{% endif %}</dd></div>
    <div><dt>Regjeringen.no</dt><dd><a href="{{ v.row.url }}">{{ v.row.url }}</a></dd></div>
  </dl>
{%- endmacro %}

{# Summary, reason, findings, reading guide and notes for one assessed hearing. show_new marks
   findings that are new since the last report (operational report only). #}
{% macro analysis(v, show_new=false) %}
  <h4>Hva foreslås</h4>
  <p>{{ v.assessment.summary }}</p>
  <h4>Begrunnelse for relevansnivå</h4>
  <p>{{ v.assessment.relevance_reason }}</p>

  <h4>Funn</h4>
  {% if not v.findings %}<p class="empty">Ingen konkrete funn oppgitt.</p>{% endif %}
  {% for f in v.findings %}
  <div class="finding{% if not f.quote_verified %} unverified{% endif %}">
    <div class="head">{% if show_new and f.is_new %}<span class="tag new" style="margin: 0 1.5mm 0 0">Ny</span>{% endif %}<strong>{{ f.category_label }}</strong> · {{ f.document_title or f.document_ref }}{% if f.chapter %}, {{ f.chapter }}{% endif %}, {% if f.page_href %}<a class="page" href="{{ f.page_href }}">s. {{ f.page }}</a>{% else %}s. {{ f.page }}{% endif %}{% if f.quote_verified and f.page_stated and f.page_stated != f.page %} <span class="muted">(modellen oppga s. {{ f.page_stated }})</span>{% endif %}</div>
    <div>{{ f.description }}</div>
    <div class="quote">«{{ f.quote }}»</div>
    {% if f.quote_verified %}
    <div class="verified">Sitat verifisert mot dokumentteksten</div>
    {% else %}
    <div class="warning"><span class="flag">UVERIFISERT</span> Sitatet ble ikke funnet i dokumentteksten – kontroller mot kilden før bruk.</div>
    {% endif %}
  </div>
  {% endfor %}

  <h4>Leseguide</h4>
  {% if v.reading_guide %}
  <p>{% for g in v.reading_guide %}{{ g.title }}: s. {{ page_ranges(g.ranges) }}{% if g.page_count %} av {{ g.page_count }}{% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}{% if v.reading_share %}<br><span class="muted">Totalt {{ v.reading_share }} i dokumentene. Klikk på et sidetall for å åpne dokumentet på den siden.</span>{% endif %}</p>
  {% else %}<p class="empty">Ingen sider pekt ut.</p>{% endif %}

  {% if v.unread_documents or v.notes %}
  <h4>Merknader</h4>
  <p class="muted">
    {% for d in v.unread_documents %}Ikke lest: {{ d }}<br>{% endfor %}
    {% for n in v.notes %}{{ n }}<br>{% endfor %}
  </p>
  {% endif %}
{%- endmacro %}
